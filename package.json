{
  "name": "lol-player-reviewer",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "node --experimental-transform-types --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app server shared tests docs nuxt.config.ts playwright.config.ts package.json README.md .prettierrc.json",
    "format:check": "prettier --check app server shared tests docs nuxt.config.ts playwright.config.ts package.json README.md .prettierrc.json",
    "check:riot-key": "node --env-file-if-exists=.env scripts/check-riot-key.mjs"
  },
  "dependencies": {
    "@tabler/icons-vue": "^3.49.0",
    "nuxt": "^4.6.1",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "vue-tsc": "^3.3.13"
  }
}
